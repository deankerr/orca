{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "setup",
      "command": "bun install --frozen-lockfile && bun run worktree:setup",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "dev",
      "command": "bunx turbo run dev --filter=@orca/start --filter=@orca/backend",
      "icon": "play",
      "async": true,
      "previewUrl": "https://orca-start.localhost"
    },
    {
      "name": "teardown",
      "command": "bun run worktree:teardown",
      "icon": "configure",
      "runOnSettle": true
    }
  ]
}

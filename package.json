{
  "name": "orca",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=web",
    "check": "ultracite check",
    "dev": "turbo run dev --filter=!entity-logo-service",
    "dev:backend": "turbo run dev --filter=@orca/backend",
    "dev:next": "turbo run dev --filter=web",
    "fix": "ultracite fix",
    "knip": "knip",
    "logos": "bun run --cwd apps/logos build",
    "prepare": "lefthook install --reset-hooks-path",
    "release": "turbo run release --filter=web",
    "space": "bun run packages/scripts/space-multiline-statements.ts",
    "start": "turbo run start --filter=web"
  },
  "devDependencies": {
    "@orca/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.35.1",
    "lefthook": "^2.1.12",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.2"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@types/bun": "1.4.2",
    "@types/node": "24.10.15",
    "convex": "1.45.0",
    "convex-helpers": "0.1.124",
    "pretty-bytes": "7.1.3",
    "remeda": "2.48.0",
    "typescript": "7.0.2",
    "zod": "4.6.2",
    "json-diff-ts": "4.10.4"
  }
}

{
  "name": "orca",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@orca/web",
    "check": "ultracite check",
    "deployments:prune": "bun run --cwd packages/scripts deployments prune",
    "dev": "portless run bun run dev:tasks",
    "dev:backend": "turbo run dev --filter=@orca/backend",
    "dev:origin": "portless get \"$(bun -p 'require(\"./portless.json\").name')\"",
    "dev:tasks": "ORCA_DEV_URL=${PORTLESS_TAILSCALE_URL:-${PORTLESS_URL:-$(bun run --silent dev:origin)}} turbo run dev",
    "dev:web": "portless run bun run dev:tasks --filter=@orca/web",
    "fix": "ultracite fix --no-error-on-unmatched-pattern",
    "generate:logos": "bun run --cwd apps/logos generate",
    "knip": "knip",
    "prepare": "lefthook install",
    "start": "turbo run start --filter=@orca/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "worktree:setup": "bun run --cwd packages/scripts deployments setup",
    "worktree:teardown": "bun run --cwd packages/scripts deployments teardown"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@orca/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "convex": "1.48.0",
    "convex-helpers": "0.1.129",
    "remeda": "2.53.0",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "json-diff-ts": "npm:@deankerr/json-diff-ts@4.10.5",
    "vitest": "5.0.5",
    "vite": "8.3.5"
  }
}

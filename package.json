{
  "name": "orca",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "archive": "bun run apps/archive/src/cli.ts",
    "build": "turbo run build --filter=web",
    "check": "ultracite check --type-aware --type-check --disable-nested-config",
    "dev": "turbo run dev --filter=!entity-logo-service",
    "dev:backend": "turbo run dev --filter=@orca/backend",
    "dev:next": "turbo run dev --filter=web",
    "fix": "ultracite fix --type-aware --type-check --disable-nested-config",
    "knip": "knip",
    "knip:production": "knip --production",
    "labs": "bun run apps/labs/src/bin.ts",
    "logos": "bun run --cwd apps/logos build",
    "prepare": "husky",
    "release": "turbo run release --filter=web",
    "start": "turbo run start --filter=web"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "fallow": "^3.3.0",
    "husky": "^9.1.7",
    "knip": "6.26.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "ultracite": "7.10.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.101"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix --type-aware --type-check --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/platform-bun": "4.0.0-beta.101",
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/sql-d1": "4.0.0-beta.101",
    "@effect/sql-sqlite-bun": "4.0.0-beta.101",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.15",
    "alchemy": "2.0.0-beta.64",
    "convex": "1.42.3",
    "effect": "4.0.0-beta.101",
    "convex-helpers": "0.1.120",
    "pretty-bytes": "7.1.0",
    "remeda": "2.39.0",
    "typescript": "^7",
    "zod": "4.4.3",
    "json-diff-ts": "4.10.4"
  }
}

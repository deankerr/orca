{
  "name": "orca",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=web",
    "check": "ultracite check --disable-nested-config",
    "dev": "turbo run dev --filter=!entity-logo-service",
    "dev:backend": "turbo run dev --filter=@orca/backend",
    "dev:next": "turbo run dev --filter=web",
    "fix": "ultracite fix --disable-nested-config",
    "knip": "knip",
    "logos": "bun run --cwd apps/logos build",
    "prepare": "lefthook install --reset-hooks-path && effect-tsgo patch --typescript --oxlint",
    "release": "turbo run release --filter=web",
    "start": "turbo run start --filter=web",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@orca/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.32.1",
    "lefthook": "^2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "ultracite": "7.10.2"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/sql-d1": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.15",
    "alchemy": "2.0.0-beta.70",
    "convex": "1.42.3",
    "effect": "4.0.0-beta.102",
    "convex-helpers": "0.1.120",
    "pretty-bytes": "7.1.0",
    "remeda": "2.39.0",
    "typescript": "7.0.2",
    "zod": "4.4.3",
    "json-diff-ts": "4.10.4"
  }
}

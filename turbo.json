{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream-with-experimental-timestamps",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "POSTHOG_API_KEY",
        "POSTHOG_PROJECT_ID",
        "VERCEL_ENV",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORTLESS*", "ORCA_DEV_ORIGIN"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
